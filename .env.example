# Copy to .env in the app folder (next to backend/). Never commit .env.
# .env is gitignored; this template is safe to commit and stays key-free.

# --- Auth: JWT + real email OTP ---
# JWT_SECRET: any long random string (tokens are signed with it). If unset, a
# random per-process secret is used and sessions reset on restart.
JWT_SECRET=
# Gmail account used to send OTP emails. If either of these is left blank, the
# server falls back to dev mode and returns the OTP in the response (demo_otp).
EMAIL_USER=
EMAIL_PASS=            # Gmail App Password, not your normal password

# --- LLM agents (parliament) — Command Code key from https://commandcode.ai/settings/keys ---
COMMANDCODE_API_KEY=
# COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
# COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
# LLM_PROVIDER=commandcode

# Or DeepSeek / OpenRouter directly (whichever key is set wins):
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# LLM_PROVIDER=commandcode        # commandcode | deepseek | openrouter — optional force
# LLM_MAX_TOKENS=600              # default 600 on commandcode (reasoning spends budget), 90 otherwise
# LLM_CHAT_ATTEMPTS=3            # retries when the provider returns an EMPTY answer (reasoning
#                                 # models behind commandcode do this intermittently)
# LLM_TIMEOUT=30

# --- FoodoScope (RecipeDB / FlavorDB) — campus network ---
FOODOSCOPE_API_KEY=
FOODOSCOPE_BASE_URL=http://cosylab.iiitd.edu.in:6969
# CocktailDB is 18+ gated by event policy (alcohol data; this product is non-alcoholic).
# Set to 1 ONLY if the team's shortlist email says CLEARED — otherwise leave unset.
# FOODOSCOPE_COCKTAILDB=1

# --- Agent tool calling (the council agents reading RecipeDB / FlavorDB) ---
# auto (default) = on whenever an LLM key is set; off/0 disables the tool path.
# LLM_TOOLS=auto
# How many tool rounds a turn may take before the model must answer (default 2).
# LLM_TOOL_HOPS=2
